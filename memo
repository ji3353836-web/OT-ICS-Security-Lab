# Rule 1: Detect any access to Modbus port 502
alert tcp any any -> any 502 (msg:"OT - Modbus Access Attempt"; sid:1000001; rev:1;)

# Rule 2: Detect Modbus Write command
alert tcp any any -> any 502 (msg:"OT - Modbus Write Attack Suspected"; content:"|00 00|"; offset:0; depth:2; sid:1000002; rev:1;)

# Rule 3: Detect Modbus Scan / DoS
alert tcp any any -> any 502 (msg:"OT - Modbus Scan Suspected"; threshold:type both, track by_src, count 20, seconds 10; sid:1000003; rev:1;)
